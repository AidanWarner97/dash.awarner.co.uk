# Tile Image Generator identity and source.
TILEIMAGEGEN_TITLE="Tile Image Generator"
TILEIMAGEGEN_DOMAIN=tileimagegen.uk
TILEIMAGEGEN_ICON=grid-2x2
TILEIMAGEGEN_DESCRIPTION="Manage the generator, its data and application configuration."
TILEIMAGEGEN_ROOT=/path/to/tile-image-gen

# Tile Image Generator database credentials.
TILEIMAGEGEN_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=tile_image_gen;charset=utf8mb4
TILEIMAGEGEN_DB_NAME=tile_image_gen
TILEIMAGEGEN_DB_TABLE_PREFIX=
TILEIMAGEGEN_DB_USER=dashboard_user
TILEIMAGEGEN_DB_PASSWORD=change-me

# SMTP notifications for feedback receipts and public comments.
TILEIMAGEGEN_SMTP_HOST=smtp.example.com
TILEIMAGEGEN_SMTP_PORT=587
TILEIMAGEGEN_SMTP_ENCRYPTION=tls
TILEIMAGEGEN_SMTP_USERNAME=notifications@example.com
TILEIMAGEGEN_SMTP_PASSWORD=change-me
TILEIMAGEGEN_SMTP_FROM_EMAIL=notifications@example.com
TILEIMAGEGEN_SMTP_FROM_NAME="Tile Image Generator"

# Inbound replies. This is the support address recipients see and reply to.
TILEIMAGEGEN_REPLY_EMAIL=support@example.com
TILEIMAGEGEN_IMAP_HOST=imap.example.com
TILEIMAGEGEN_IMAP_PORT=993
TILEIMAGEGEN_IMAP_ENCRYPTION=ssl
# Optional when the IMAP login matches the SMTP username and password.
TILEIMAGEGEN_IMAP_USERNAME=
TILEIMAGEGEN_IMAP_PASSWORD=
TILEIMAGEGEN_IMAP_MAILBOX=INBOX

# Discord notification for new feedback submissions.
TILEIMAGEGEN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/change-me

# Personal Portfolio identity and source.
PORTFOLIO_TITLE="Personal Portfolio"
PORTFOLIO_DOMAIN=awarner.co.uk
PORTFOLIO_ICON=briefcase-business
PORTFOLIO_DESCRIPTION="Manage portfolio content, enquiries and site configuration."
PORTFOLIO_ROOT=/path/to/portfolio

# Personal Portfolio database credentials.
PORTFOLIO_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=portfolio;charset=utf8mb4
PORTFOLIO_DB_NAME=portfolio
PORTFOLIO_DB_TABLE_PREFIX=
PORTFOLIO_DB_USER=dashboard_user
PORTFOLIO_DB_PASSWORD=change-me

# Evolution X CDN identity and source.
EVOLUTION_CDN_TITLE="Evolution X CDN"
EVOLUTION_CDN_DOMAIN=cdn.evolution-x.org
EVOLUTION_CDN_ICON=cloud-download
EVOLUTION_CDN_DESCRIPTION="Monitor downloads, release delivery, storage, and CDN operations."
EVOLUTION_CDN_ROOT=/path/to/cdn.evolution-x.org

# Evolution X CDN database credentials.
EVOLUTION_CDN_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=filebrowser;charset=utf8mb4
EVOLUTION_CDN_DB_NAME=filebrowser
EVOLUTION_CDN_DB_TABLE_PREFIX=
EVOLUTION_CDN_DB_USER=dashboard_user
EVOLUTION_CDN_DB_PASSWORD=change-me

# Evolution X Discord Bots identity and source.
DISCORD_BOTS_TITLE="Evolution X Discord Bots"
DISCORD_BOTS_DOMAIN=mm-dashboard.evolution-x.org
DISCORD_BOTS_ICON=bot
DISCORD_BOTS_DESCRIPTION="Monitor Bender, Scruffy, Professor, and their shared services."
DISCORD_BOTS_ROOT=/path/to/evo-discord-bots

# Signed Professor management API. These can also be saved in project settings.
DISCORD_BOTS_API_URL=https://mm-dashboard.evolution-x.org
DISCORD_BOTS_API_IDENTIFIER=awarner-dashboard
DISCORD_BOTS_API_SECRET=replace-with-at-least-32-random-characters

# Evolution X CDN Bunny Storage browser.
EVOLUTION_CDN_BUNNY_STORAGE_ZONE=evolution-builds
EVOLUTION_CDN_BUNNY_STORAGE_ACCESS_KEY=change-me
EVOLUTION_CDN_BUNNY_STORAGE_HOST=storage.bunnycdn.com
EVOLUTION_CDN_BUNNY_STORAGE_REGION=de
EVOLUTION_CDN_BUNNY_CDN_HOST=downloads.evolution-x.org

# Keep disabled until dashboard administrator authentication is configured.
DASHBOARD_ALLOW_WRITES=false
DASHBOARD_WEBAUTHN_RP_ID=dash.awarner.co.uk

# Runtime infrastructure. This directory must be writable by the PHP-FPM user.
DASHBOARD_CACHE_DIR=/var/cache/awarner-dashboard
EVOLUTION_CDN_OVERVIEW_CACHE_SECONDS=60